# Copy to .env and fill in real values. Never commit .env.

PORT=5001

# Public URLs (used in email links, redirects and CORS)
FRONTEND_URL=http://localhost:10300
BACKEND_URL=http://localhost:5001
# Extra browser origins allowed to call the API (comma separated, optional)
# CORS_ORIGINS=http://localhost:10300
# Number of reverse proxies in front of the API (0 when none)
TRUST_PROXY=0

# PostgreSQL (docker-compose.yml reads these too)
DB_HOST=localhost
DB_PORT=5433
DB_USER=cyberuser
DB_PASSWORD=change-me-to-a-long-random-password
DB_NAME=cybersecurity_db

# MongoDB (learn-path progress; docker-compose.yml reads these too)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=cyberthulir_learn
MONGO_ROOT_USER=mongoadmin
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-password
MONGO_APP_USER=cyberlearn
MONGO_APP_PASSWORD=change-me-to-another-long-random-password
# Or give a full connection string instead (overrides the values above)
# MONGODB_URI=mongodb://user:pass@host:27017/cyberthulir_learn?authSource=cyberthulir_learn

# Gmail app password (https://myaccount.google.com/apppasswords)
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Session cookie (httpOnly). Defaults: Secure when BACKEND_URL is https,
# SameSite=lax. Host the frontend and API on the same site
# (e.g. app.example.com + api.example.com) so the cookie is sent.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Optional: share rate-limit counters between several API instances
# REDIS_URL=redis://localhost:6379
