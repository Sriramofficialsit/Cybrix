// use prisma-8
// Contract inferred from the live database schema.
// Edit as needed, then run `prisma contract emit`.
model Admins {
  id                           Uuid                           @id(map: "admins_pkey") @default(dbgenerated("gen_random_uuid()"))
  name                         VarChar(100)
  email                        VarChar(255)                   @unique(map: "admins_email_key")
  passwordHash                 String                         @map("password_hash")
  isEmailVerified              Boolean                        @default(false) @map("is_email_verified")
  createdAt                    Timestamp?                     @default(now()) @map("created_at")
  updatedAt                    Timestamp?                     @default(now()) @map("updated_at")
  username                     VarChar(30)?                   @unique(map: "admins_username_key")
  adminRole                    VarChar(20)                    @default("admin") @map("admin_role")
  tokenVersion                 Int                            @default(0) @map("token_version")
  adminEmailVerificationTokens AdminEmailVerificationTokens[]

  @@check(expression: "((admin_role)::text = ANY (ARRAY[('admin'::character varying)::text, ('superior_admin'::character varying)::text]))", name: "ck_admin_role_allowed_v1")
}

model AdminEmailVerificationTokens {
  id        Uuid       @id(map: "admin_email_verification_tokens_pkey") @default(dbgenerated("gen_random_uuid()"))
  adminId   Uuid       @map("admin_id")
  token     String     @unique(map: "admin_email_verification_tokens_token_key")
  expiresAt Timestamp  @map("expires_at")
  createdAt Timestamp? @default(now()) @map("created_at")
  admin     Admins     @relation(fields:[adminId], references:[id], onDelete: Cascade, map: "admin_email_verification_tokens_admin_id_fkey", index: false)

  @@map("admin_email_verification_tokens")
}

model Colleges {
  id          Uuid         @id(map: "colleges_pkey") @default(dbgenerated("gen_random_uuid()"))
  collegeName VarChar(200) @unique(map: "colleges_college_name_key") @map("college_name")
  createdAt   Timestamp?   @default(now()) @map("created_at")

  @@map("colleges")
}

model EmailVerificationTokens {
  id        Uuid        @id(map: "email_verification_tokens_pkey") @default(dbgenerated("gen_random_uuid()"))
  userId    Uuid        @map("user_id")
  token     String      @unique(map: "email_verification_tokens_token_key")
  expiresAt Timestamp   @map("expires_at")
  createdAt Timestamp?  @default(now()) @map("created_at")
  userType  VarChar(20) @default("learner") @map("user_type")

  @@check(expression: "((user_type)::text = ANY (ARRAY[('learner'::character varying)::text, ('student'::character varying)::text, ('faculty'::character varying)::text, ('professional'::character varying)::text, ('recruiter'::character varying)::text]))", name: "ck_email_verification_user_type_v1")

  @@map("email_verification_tokens")
}

model LoginOtps {
  id             Uuid        @id(map: "login_otps_pkey") @default(dbgenerated("gen_random_uuid()"))
  accountId      Uuid        @map("account_id")
  otp            String
  accountType    VarChar(20) @map("account_type")
  expiresAt      Timestamp   @map("expires_at")
  createdAt      Timestamp?  @default(now()) @map("created_at")
  loginTokenHash String      @unique(map: "login_otps_login_token_hash_key") @map("login_token_hash")
  attempts       Int         @default(0)
  resendCount    Int         @default(0) @map("resend_count")
  lastSentAt     Timestamptz @default(now()) @map("last_sent_at")

  @@check(expression: "((account_type)::text = ANY (ARRAY[('user'::character varying)::text, ('admin'::character varying)::text]))", name: "ck_login_otp_account_type_v1")

  @@map("login_otps")
}

model Organisation {
  id                     Uuid          @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()"))
  email                  VarChar(255)  @unique(map: "users_email_key")
  passwordHash           String        @map("password_hash")
  isEmailVerified        Boolean       @default(false) @map("is_email_verified")
  createdAt              Timestamp?    @default(now()) @map("created_at")
  updatedAt              Timestamp?    @default(now()) @map("updated_at")
  pendingEmail           VarChar(255)? @map("pending_email")
  emailChangeToken       String?       @map("email_change_token")
  emailChangeExpiresAt   Timestamp?    @map("email_change_expires_at")
  emailChangeReportToken String?       @map("email_change_report_token")
  username               VarChar(30)   @unique(map: "learners_username_key")
  currentStatus          VarChar(30)?  @default("active") @map("current_status")
  userType               VarChar(20)   @default("student") @map("user_type")
  lastActiveAt           Timestamp?    @default(now()) @map("last_active_at")
  collegeName            VarChar(150)? @map("college_name")
  department             VarChar(100)?
  contactNumber          VarChar(20)?  @map("contact_number")
  year                   VarChar(20)?
  designation            VarChar(150)?
  linkedinProfile        String?       @map("linkedin_profile")
  tokenVersion           Int           @default(0) @map("token_version")

  @@check(expression: "((user_type)::text = ANY (ARRAY[('student'::character varying)::text, ('faculty'::character varying)::text]))", name: "ck_organisation_user_type_v1")
}

model PasswordResetTokens {
  id        Uuid        @id(map: "password_reset_tokens_pkey") @default(dbgenerated("gen_random_uuid()"))
  userId    Uuid        @map("user_id")
  token     String      @unique(map: "password_reset_tokens_token_key")
  expiresAt Timestamp   @map("expires_at")
  createdAt Timestamp?  @default(now()) @map("created_at")
  userType  VarChar(20) @default("learner") @map("user_type")

  @@check(expression: "((user_type)::text = ANY (ARRAY[('learner'::character varying)::text, ('student'::character varying)::text, ('faculty'::character varying)::text, ('professional'::character varying)::text, ('recruiter'::character varying)::text]))", name: "ck_password_reset_user_type_v1")

  @@map("password_reset_tokens")
}

model Professionals {
  id              Uuid          @id(map: "professionals_recruiters_pkey") @default(dbgenerated("gen_random_uuid()"))
  name            VarChar(100)
  username        VarChar(30)   @unique(map: "professionals_recruiters_username_key")
  email           VarChar(255)  @unique(map: "professionals_recruiters_email_key")
  passwordHash    String        @map("password_hash")
  contactNumber   VarChar(20)?  @map("contact_number")
  userType        VarChar(20)   @map("user_type")
  companyName     VarChar(150)? @map("company_name")
  designation     VarChar(255)?
  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  createdAt       Timestamp?    @default(now()) @map("created_at")
  updatedAt       Timestamp?    @default(now()) @map("updated_at")
  currentStatus   VarChar(30)   @default("active") @map("current_status")
  lastActiveAt    Timestamp?    @default(now()) @map("last_active_at")
  fullName        VarChar(100)? @map("full_name")
  linkedinProfile String?       @map("linkedin_profile")
  tokenVersion    Int           @default(0) @map("token_version")

  @@check(expression: "((designation)::text = ANY (ARRAY[('HR'::character varying)::text, ('Technical'::character varying)::text, ('Management'::character varying)::text, ('Talent Acquisition'::character varying)::text]))", name: "ck_professional_designation_v1")

  @@check(expression: "((user_type)::text = ANY (ARRAY[('professional'::character varying)::text, ('recruiter'::character varying)::text]))", name: "ck_professional_user_type_v1")
}

model UserProfiles {
  id           Uuid         @id(map: "user_profiles_pkey") @default(dbgenerated("gen_random_uuid()"))
  userId       Uuid         @unique(map: "user_profiles_user_id_key") @map("user_id")
  bio          String?
  profileImage String?      @map("profile_image")
  phoneNumber  VarChar(20)? @map("phone_number")
  githubUrl    Jsonb?       @map("github_url")
  linkedinUrl  Jsonb?       @map("linkedin_url")
  createdAt    Timestamp?   @default(now()) @map("created_at")
  updatedAt    Timestamp?   @default(now()) @map("updated_at")

  @@map("user_profiles")
}

model Users {
  id                     Uuid          @id(map: "users_pkey1") @default(dbgenerated("gen_random_uuid()"))
  username               VarChar(30)   @unique(map: "users_username_key1")
  email                  VarChar(255)  @unique(map: "users_email_key1")
  passwordHash           String        @map("password_hash")
  contactNumber          VarChar(20)?  @map("contact_number")
  isEmailVerified        Boolean       @default(false) @map("is_email_verified")
  currentStatus          VarChar(30)   @default("active") @map("current_status")
  lastActiveAt           Timestamp?    @default(now()) @map("last_active_at")
  pendingEmail           VarChar(255)? @map("pending_email")
  emailChangeToken       String?       @map("email_change_token")
  emailChangeExpiresAt   Timestamp?    @map("email_change_expires_at")
  emailChangeReportToken String?       @map("email_change_report_token")
  createdAt              Timestamp?    @default(now()) @map("created_at")
  updatedAt              Timestamp?    @default(now()) @map("updated_at")
  currentlyDoing         VarChar(150)? @map("currently_doing")
  linkedinProfile        String?       @map("linkedin_profile")
  tokenVersion           Int           @default(0) @map("token_version")

  @@check(expression: "((currently_doing)::text = ANY (ARRAY[('Student'::character varying)::text, ('Freelancer'::character varying)::text, ('Job seeking'::character varying)::text, ('Other'::character varying)::text]))", name: "ck_user_currently_doing_v1")
}

model LabProgress {
  accountId     Uuid         @map("account_id")
  accountType   VarChar(20)  @map("account_type")
  labSlug       VarChar(60)  @map("lab_slug")
  status        VarChar(20)  @default("in_progress")
  hintsRevealed Int          @default(0) @map("hints_revealed")
  hintPenalty   Int          @default(0) @map("hint_penalty")
  attempts      Int          @default(0)
  score         Int?
  state         Jsonb        @default(dbgenerated("'{}'::jsonb"))
  startedAt     Timestamptz  @default(now()) @map("started_at")
  completedAt   Timestamptz? @map("completed_at")
  updatedAt     Timestamptz  @default(now()) @map("updated_at")

  @@id([accountId, accountType, labSlug], map: "lab_progress_pkey")

  @@check(expression: "((account_type)::text = ANY (ARRAY[('learner'::character varying)::text, ('organisation'::character varying)::text, ('professionals'::character varying)::text]))", name: "ck_lab_progress_account_type_v1")

  @@check(expression: "((status)::text = ANY (ARRAY[('in_progress'::character varying)::text, ('completed'::character varying)::text]))", name: "ck_lab_progress_status_v1")

  @@index([labSlug, status], map: "lab_progress_lab_slug_idx")

  @@map("lab_progress")
}
